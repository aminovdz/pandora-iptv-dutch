---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PricingCard from '../components/PricingCard.astro';
import ReferralSection from '../components/ReferralSection.astro';
import LiveScores from '../components/LiveScores.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import SupportedDevices from '../components/SupportedDevices.astro';
import CitiesList from '../components/CitiesList.astro';
import UserReviewsSection from '../components/UserReviewsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import SocialPopup from '../components/SocialPopup.astro';
import ExitPopup from '../components/ExitPopup.astro';

// SEO details
const title = "Pandora IPTV Nederland | #1 IPTV Service in NL | 4K & VOD";
const description = "Kies voor Pandora IPTV in Nederland. Kijk 4K live sport, de nieuwste films & series zonder haperingen. Start vandaag nog met de beste IPTV service.";
---

<Layout title={title} description={description}>
  <StickyHeader />
  
  <main>
    <Hero />
    <FeatureGrid />
    
    <!-- Pricing Section (Positioned Directly Above Referral) -->
    <section id="pricing" class="py-24 relative z-10 bg-background/50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Kies Je Abonnement</h2>
          <p class="text-xl text-gray-400 max-w-2xl mx-auto">Geen verborgen kosten, direct toegang. Al onze pakketten bevatten alle premium zenders en VOD in 4K/FHD kwaliteit.</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto items-stretch">
          <PricingCard months="12" price="35" popular={true} hasBonus={true} />
          <PricingCard months="6" price="20" popular={false} />
          <PricingCard months="3" price="10" popular={false} />
          <PricingCard months="1" price="5" popular={false} />
        </div>
      </div>
    </section>

    <!-- Referral Section Directly Under Pricing -->
    <ReferralSection />

    <LiveScores />
    <ProcessSteps />
    <SupportedDevices />
    <CitiesList />
    <UserReviewsSection />
    <FAQSection />
    <CTASection />
  </main>
  
  <Footer />
  <FloatingWhatsApp />
  <SocialPopup />
  <ExitPopup />
</Layout>
