---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | Pandora IPTV" description="Neem contact op met Pandora IPTV. Wij bieden 24/7 ondersteuning via WhatsApp, Telegram en E-mail.">
  <StickyHeader />
  
  <main class="pt-32 pb-0">
    <div class="container mx-auto px-4 text-center max-w-3xl mb-8">
      <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">Hoe kunnen we je helpen?</h1>
      <p class="text-gray-400 text-lg">
        Bij Pandora IPTV staat de klant voorop. Kies de contactmethode die jij het prettigst vindt.
      </p>
    </div>

    <!-- We reuse the ContactForm component which contains all the layout, info, and the form -->
    <ContactForm />
  </main>
  
  <Footer />
</Layout>
