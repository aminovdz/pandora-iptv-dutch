---
import { getEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { Calendar, Clock, ChevronRight, ShieldCheck, MessageCircle, BookOpen, Gift, CheckCircle2, ArrowRight, Tv } from 'lucide-astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry: any) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { slug } = Astro.params;
const { entry } = Astro.props as any;

if (!entry) {
  return Astro.redirect('/404');
}

const allGuides = await getCollection('guides');
const otherGuides = allGuides.filter((g: any) => g.slug !== slug);

const { Content } = await entry.render();

const formattedDate = entry.data.pubDate 
  ? new Date(entry.data.pubDate).toLocaleDateString('nl-NL', { year: 'numeric', month: 'long', day: 'numeric' })
  : 'Augustus 2026';
---

<Layout title={`${entry.data.title} | Pandora IPTV`} description={entry.data.description}>
  <StickyHeader />
  
  <main class="pt-32 pb-24 relative overflow-hidden">
    
    <!-- Background Glows -->
    <div class="absolute top-20 left-1/4 w-[600px] h-[350px] bg-primary/15 blur-[160px] pointer-events-none"></div>
    <div class="absolute top-1/2 right-10 w-[500px] h-[400px] bg-secondary/10 blur-[150px] pointer-events-none"></div>

    <div class="container mx-auto px-4 max-w-7xl relative z-10">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 mb-8 overflow-x-auto whitespace-nowrap pb-2">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-600 shrink-0" />
        <a href="/guides" class="hover:text-white transition-colors">Kennisbank</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-600 shrink-0" />
        <span class="text-primary font-semibold truncate max-w-[280px] md:max-w-none">{entry.data.title}</span>
      </nav>

      <!-- Main Layout: 2 Columns on Desktop -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Article Content -->
        <article class="lg:col-span-8 bg-white/[0.02] border border-white/10 rounded-3xl p-6 md:p-10 backdrop-blur-xl">
          
          <!-- Post Header -->
          <header class="mb-10 pb-8 border-b border-white/10">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-black uppercase tracking-wider mb-4">
              <BookOpen class="w-3.5 h-3.5" />
              <span>Geverifieerde Installatiehandleiding</span>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-6 leading-[1.2]">
              {entry.data.title}
            </h1>

            <p class="text-base sm:text-lg text-gray-300 leading-relaxed mb-6">
              {entry.data.description}
            </p>

            <!-- Meta Tags Bar -->
            <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs sm:text-sm text-gray-400">
              <div class="flex items-center gap-1.5">
                <Calendar class="w-4 h-4 text-primary" />
                <span>{formattedDate}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <Clock class="w-4 h-4 text-secondary" />
                <span>Leestijd: ~4 min</span>
              </div>
              <div class="flex items-center gap-1.5 text-green-400 font-semibold">
                <ShieldCheck class="w-4 h-4" />
                <span>100% Werkend Getest</span>
              </div>
            </div>
          </header>

          <!-- Featured Cover Image -->
          {entry.data.heroImage && (
            <div class="relative rounded-2xl overflow-hidden mb-10 border border-white/10 shadow-2xl">
              <img 
                src={entry.data.heroImage} 
                alt={entry.data.title}
                class="w-full h-auto object-cover rounded-2xl"
                loading="eager"
                width="1200"
                height="675"
              />
            </div>
          )}

          <!-- Markdown Content Body -->
          <div class="prose prose-invert prose-lg max-w-none
            prose-headings:font-black prose-headings:tracking-tight prose-headings:text-white
            prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pb-3 prose-h2:border-b prose-h2:border-white/10
            prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-4 prose-h3:text-gray-100
            prose-h4:text-lg prose-h4:mt-6 prose-h4:mb-3 prose-h4:text-gray-200
            prose-p:text-gray-300 prose-p:leading-[1.8] prose-p:mb-6 prose-p:text-base sm:prose-p:text-lg
            prose-ul:my-6 prose-ul:space-y-3 prose-li:text-gray-300 prose-li:leading-relaxed
            prose-ol:my-6 prose-ol:space-y-4 prose-ol:text-gray-200
            prose-strong:text-white prose-strong:font-bold
            prose-a:text-primary hover:prose-a:text-red-400 prose-a:font-bold prose-a:underline
            prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-white/5 prose-blockquote:p-6 prose-blockquote:rounded-r-2xl prose-blockquote:my-8 prose-blockquote:text-gray-200
            prose-code:bg-white/10 prose-code:px-2.5 prose-code:py-1 prose-code:rounded-lg prose-code:text-primary prose-code:font-mono prose-code:text-sm
            prose-pre:bg-black/80 prose-pre:border prose-pre:border-white/10 prose-pre:rounded-2xl prose-pre:p-6 prose-pre:my-8
            prose-table:w-full prose-table:my-8 prose-table:border-collapse
            prose-th:bg-white/10 prose-th:p-4 prose-th:text-white prose-th:font-bold prose-th:text-left prose-th:border prose-th:border-white/10
            prose-td:p-4 prose-td:border prose-td:border-white/10 prose-td:text-gray-300
          ">
            <Content />
          </div>

          <!-- Post Footer Support Box -->
          <div class="mt-14 p-8 bg-gradient-to-br from-primary/20 via-background to-secondary/15 rounded-3xl border border-white/15 text-center">
            <div class="w-14 h-14 rounded-2xl bg-[#25D366]/20 flex items-center justify-center mx-auto mb-4 text-[#25D366]">
              <MessageCircle class="w-7 h-7" />
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Hulp nodig bij de installatie?</h3>
            <p class="text-gray-300 text-sm max-w-md mx-auto mb-6">
              Onze technische ondersteuning helpt je graag stap-voor-stap live via WhatsApp. We kunnen de koppeling ook op afstand uitvoeren.
            </p>
            <a 
              href="https://wa.me/18036582620" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold rounded-xl shadow-lg transition-all hover:scale-105"
            >
              <MessageCircle class="w-5 h-5" />
              <span>Direct Hulp via WhatsApp (+1 803-658-2620)</span>
            </a>
          </div>

        </article>

        <!-- Right: Sticky Conversion Sidebar -->
        <aside class="lg:col-span-4 space-y-8 sticky top-28">
          
          <!-- 12-Month Deal Promotion Box -->
          <div class="bg-gradient-to-b from-primary/25 via-background to-background border-2 border-primary/50 rounded-3xl p-6 md:p-8 backdrop-blur-xl shadow-[0_0_40px_rgba(174,28,40,0.2)]">
            <div class="inline-flex items-center gap-1.5 bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 text-xs font-bold px-3 py-1 rounded-full mb-4">
              <Gift class="w-3.5 h-3.5" />
              <span>Beste Aanbieding</span>
            </div>

            <h3 class="text-2xl font-black text-white mb-2">12 Maanden + IBO Bonus</h3>
            <p class="text-gray-400 text-xs mb-4">Inclusief gratis levenslange IBO Player app activatie t.w.v. €10.</p>

            <div class="flex items-baseline gap-1 mb-6">
              <span class="text-2xl font-bold text-gray-400">€</span>
              <span class="text-5xl font-black text-white">35</span>
              <span class="text-gray-400 text-sm font-medium">/jaar</span>
            </div>

            <ul class="space-y-2.5 text-xs text-gray-300 mb-6">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-green-400 shrink-0" />
                <span>Compleet Aanbod Live TV & VOD in 4K</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-green-400 shrink-0" />
                <span>Gratis IBO Player Activatie</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-green-400 shrink-0" />
                <span>100% Anti-Freeze Dedicated Server</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-green-400 shrink-0" />
                <span>24/7 Persoonlijke WhatsApp Support</span>
              </li>
            </ul>

            <a 
              href="https://wa.me/18036582620?text=Hallo!%20Ik%20wil%20graag%20het%20Pandora%20IPTV%2012%20Maanden%20pakket%20(%E2%82%AC35)%20bestellen."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3.5 bg-primary hover:bg-primary/90 text-white font-extrabold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2 text-sm hover:scale-[1.02]"
            >
              <MessageCircle class="w-4 h-4" />
              <span>Direct Bestellen via WhatsApp</span>
            </a>
          </div>

          <!-- Other Guides Widget -->
          <div class="bg-white/5 border border-white/10 rounded-3xl p-6 backdrop-blur-xl">
            <h4 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              <Tv class="w-5 h-5 text-primary" />
              <span>Andere Handleidingen</span>
            </h4>
            <div class="space-y-3">
              {otherGuides.map((guide: any) => (
                <a 
                  href={`/guides/${guide.slug}`}
                  class="block p-3 bg-white/5 hover:bg-white/10 border border-white/5 hover:border-primary/40 rounded-xl transition-all group"
                >
                  <p class="text-sm font-bold text-white group-hover:text-primary transition-colors line-clamp-2">
                    {guide.data.title}
                  </p>
                  <span class="text-[11px] text-gray-400 flex items-center gap-1 mt-1">
                    <span>Lees Gids</span>
                    <ArrowRight class="w-3 h-3 text-primary" />
                  </span>
                </a>
              ))}
            </div>
          </div>

        </aside>

      </div>

    </div>
  </main>
  
  <Footer />
  <FloatingWhatsApp />
</Layout>
