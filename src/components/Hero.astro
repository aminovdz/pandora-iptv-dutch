---
import { Play, ShieldCheck, Zap, CheckCircle2 } from 'lucide-astro';
---

<section class="relative pt-32 pb-20 lg:pt-44 lg:pb-32 overflow-hidden">
  <!-- Ambient Lighting Effects -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-primary/20 blur-[140px] rounded-full mix-blend-screen"></div>
    <div class="absolute top-1/3 right-10 w-[500px] h-[500px] bg-secondary/15 blur-[120px] rounded-full mix-blend-screen"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10 text-center">
    
    <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 backdrop-blur-md shadow-lg">
      <span class="flex h-2.5 w-2.5 rounded-full bg-green-500 animate-pulse"></span>
      <span class="text-xs md:text-sm font-semibold text-gray-200">Dedicated NL Streaming Servers Online</span>
    </div>

    <!-- Main Headline with Keywords -->
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white tracking-tight mb-6 max-w-4xl mx-auto leading-[1.1]">
      Ontdek de Kracht van <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-red-500 to-secondary">Pandora IPTV</span>
    </h1>
    
    <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed">
      Kies voor <strong>Pandora IPTV Nederland</strong> en geniet van alle premium live sport, films en series in haarscherpe 4K kwaliteit zonder buffering of haperingen.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a href="/#pricing" class="w-full sm:w-auto px-8 py-4 text-base md:text-lg font-extrabold text-white bg-primary hover:bg-primary/90 rounded-2xl shadow-[0_0_35px_rgba(174,28,40,0.35)] hover:scale-105 transition-all flex items-center justify-center gap-2 group">
        <Play class="w-5 h-5 group-hover:scale-110 transition-transform fill-white" />
        Bekijk Pakketten & Prijzen
      </a>
      <a href="https://wa.me/18036582620" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-8 py-4 text-base md:text-lg font-bold text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-2xl transition-all flex items-center justify-center gap-2">
        <span>Direct Chatten via WhatsApp</span>
      </a>
    </div>

    <!-- Hero Image Showcase -->
    <div class="relative max-w-5xl mx-auto rounded-3xl p-2 md:p-4 bg-white/5 border border-white/15 backdrop-blur-2xl shadow-[0_20px_60px_rgba(0,0,0,0.6)] group">
      <div class="relative overflow-hidden rounded-2xl">
        <img 
          src="/images/hero-streaming.jpg" 
          alt="pandora iptv nederland 4k streaming interface" 
          class="w-full h-auto object-cover rounded-2xl transform transition-transform duration-700 group-hover:scale-[1.01]"
          loading="eager"
          width="1200"
          height="675"
        />
        
        <!-- Live stream overlay tag -->
        <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6 flex items-center gap-3 bg-black/80 backdrop-blur-md px-4 py-2 rounded-xl border border-white/10">
          <div class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></div>
          <span class="text-xs md:text-sm font-bold text-white">Live Eredivisie & VOD in 4K Ultra HD</span>
        </div>
      </div>
    </div>

    <!-- Trust Badges -->
    <div class="flex flex-wrap items-center justify-center gap-8 mt-12 text-gray-400 text-sm font-medium">
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-5 h-5 text-primary" />
        <span>Anti-Freeze Server Technologie</span>
      </div>
      <div class="flex items-center gap-2">
        <Zap class="w-5 h-5 text-yellow-400" />
        <span>Directe Activatie Binnen 5 Min</span>
      </div>
      <div class="flex items-center gap-2">
        <CheckCircle2 class="w-5 h-5 text-green-400" />
        <span>Alle Smart TV's & Apparaten</span>
      </div>
    </div>

  </div>
</section>
