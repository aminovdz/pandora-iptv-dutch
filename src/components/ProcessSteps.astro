---
import { ShoppingCart, Download, PlayCircle } from 'lucide-astro';

const steps = [
  {
    num: "01",
    title: "Kies je Abonnement",
    desc: "Selecteer het pakket dat bij je past. Voor de beste waarde raden wij ons 12-maanden pakket aan.",
    icon: ShoppingCart
  },
  {
    num: "02",
    title: "Download de App",
    desc: "Installeer IBO Player, Smarters Pro of een andere app op je Smart TV, Apple TV, of Android box.",
    icon: Download
  },
  {
    num: "03",
    title: "Log in & Kijk",
    desc: "Ontvang direct je inloggegevens via e-mail of WhatsApp en begin binnen 5 minuten met streamen.",
    icon: PlayCircle
  }
];
---

<section class="py-24 relative z-10 bg-background">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Hoe Werkt <span class="text-primary">Pandora IPTV?</span></h2>
      <p class="text-gray-400 text-lg">In slechts 3 simpele stappen ben je klaar om te genieten van pandora iptv nederland.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Connecting line for desktop -->
      <div class="hidden md:block absolute top-1/2 left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-y-1/2 z-0"></div>

      {steps.map((step) => {
        const Icon = step.icon;
        return (
          <div class="relative z-10 bg-background/80 backdrop-blur-md border border-white/10 p-8 rounded-2xl text-center hover:border-primary/50 transition-colors">
            <div class="w-16 h-16 mx-auto bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center mb-6 shadow-[0_0_20px_rgba(174,28,40,0.3)]">
              <Icon class="w-8 h-8 text-white" />
            </div>
            <div class="text-4xl font-extrabold text-white/5 mb-4 absolute top-4 right-4">{step.num}</div>
            <h3 class="text-xl font-bold text-white mb-3">{step.title}</h3>
            <p class="text-gray-400 leading-relaxed">{step.desc}</p>
          </div>
        )
      })}
    </div>
  </div>
</section>
