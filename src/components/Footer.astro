---
import { Mail, MessageCircle, MapPin, Server, Activity, ShieldCheck } from 'lucide-astro';

const cities = [
  { name: 'Amsterdam', role: 'Primair Datacenter (HQ)', ping: '8ms', status: 'Optimaal' },
  { name: 'Rotterdam', role: 'Zuid-Holland Streaming Node', ping: '11ms', status: 'Optimaal' },
  { name: 'Den Haag', role: 'Randstad Relay Knooppunt', ping: '10ms', status: 'Optimaal' },
  { name: 'Utrecht', role: 'Centraal NL Glasvezel Hub', ping: '9ms', status: 'Optimaal' },
  { name: 'Eindhoven', role: 'Brabant High-Tech Node', ping: '12ms', status: 'Optimaal' },
];
---

<footer class="bg-[#050508] pt-20 pb-10 border-t border-white/10 relative overflow-hidden">
  
  <!-- Subtle ambient background glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-primary/10 blur-[150px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    
    <!-- Fake Location / Interactive Server Network Map Section in Footer -->
    <div class="mb-16 bg-white/[0.03] border border-white/10 rounded-3xl p-6 md:p-10 backdrop-blur-xl">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 mb-8 pb-8 border-b border-white/10">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-500/10 text-green-400 border border-green-500/20 text-xs font-bold uppercase tracking-wider mb-2">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
            <span>Nederlandse Server Infrastructuur Live</span>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-white">
            Lokale Serverknooppunten in Nederland
          </h3>
          <p class="text-gray-400 text-sm mt-1">
            Rechtstreeks aangesloten op de Amsterdam Internet Exchange (AMS-IX) voor minimale latency.
          </p>
        </div>

        <div class="flex items-center gap-4 text-xs font-semibold text-gray-300">
          <div class="flex items-center gap-1.5 bg-black/40 px-3 py-1.5 rounded-lg border border-white/10">
            <Activity class="w-4 h-4 text-green-400" />
            <span>Uptime: 99.98%</span>
          </div>
          <div class="flex items-center gap-1.5 bg-black/40 px-3 py-1.5 rounded-lg border border-white/10">
            <Server class="w-4 h-4 text-primary" />
            <span>10 Gbps Uplink</span>
          </div>
        </div>
      </div>

      <!-- Map & Nodes Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Interactive Stylized Location Map Graphic -->
        <div class="lg:col-span-5 relative bg-black/50 border border-white/10 rounded-2xl p-6 overflow-hidden min-h-[260px] flex flex-col justify-between">
          
          <!-- Map Background Graphic Overlay -->
          <div class="absolute inset-0 opacity-20 pointer-events-none">
            <svg viewBox="0 0 400 320" class="w-full h-full text-primary" fill="currentColor">
              <!-- Stylized geometric map contours of Netherlands -->
              <path d="M120,40 L180,30 L220,50 L260,30 L310,60 L290,120 L330,160 L300,220 L270,260 L220,290 L160,280 L130,230 L80,210 L60,160 L90,110 Z" opacity="0.4" stroke="currentColor" stroke-width="2" fill="none"/>
              <circle cx="160" cy="110" r="14" fill="#AE1C28" opacity="0.3" class="animate-ping" />
              <circle cx="160" cy="110" r="6" fill="#AE1C28" />
              <circle cx="130" cy="160" r="4" fill="#21468B" />
              <circle cx="110" cy="140" r="4" fill="#21468B" />
              <circle cx="170" cy="140" r="4" fill="#21468B" />
              <circle cx="190" cy="220" r="4" fill="#21468B" />
            </svg>
          </div>

          <div class="relative z-10">
            <div class="flex items-center justify-between text-xs text-gray-400 mb-2">
              <span class="font-mono text-[11px] text-primary">MAP_NL_NODE_V4.2</span>
              <span class="text-green-400 font-bold">● HQ ONLINE</span>
            </div>
            <h4 class="text-white font-bold text-lg">Amsterdam Datacenter HQ</h4>
            <p class="text-gray-400 text-xs mt-1">Keizersgracht 421, 1016 EK Amsterdam, Nederland</p>
          </div>

          <div class="relative z-10 pt-4 mt-6 border-t border-white/10 flex justify-between items-center text-xs">
            <span class="text-gray-400">Gemiddelde NL Responstijd:</span>
            <span class="text-green-400 font-bold font-mono">~9.2 ms</span>
          </div>
        </div>

        <!-- Node City Badges with dynamic location links -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-3">
          {cities.map((city) => (
            <a 
              href={`/locations/${city.name.toLowerCase()}`}
              class="p-3.5 bg-white/5 hover:bg-white/10 border border-white/5 hover:border-primary/50 rounded-xl transition-all flex items-center justify-between group"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                  <MapPin class="w-4 h-4" />
                </div>
                <div>
                  <h5 class="text-white font-bold text-sm group-hover:text-primary transition-colors">{city.name}</h5>
                  <p class="text-gray-400 text-[11px]">{city.role}</p>
                </div>
              </div>
              <div class="text-right font-mono text-xs">
                <span class="text-green-400 font-semibold">{city.ping}</span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </div>

    <!-- Main Footer Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      
      <!-- Brand & About -->
      <div>
        <a href="/" class="flex items-center gap-2 mb-6">
          <span class="text-2xl font-black text-white tracking-tight">Pandora <span class="text-primary">IPTV</span></span>
        </a>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          De meest betrouwbare en geavanceerde streaming service van Nederland. Jouw premium partner voor live sport, blockbusters en series in 4K.
        </p>
        <div class="flex items-center gap-4">
          <a href="https://wa.me/18036582620" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:bg-[#25D366] hover:text-white transition-colors" aria-label="WhatsApp">
            <MessageCircle class="w-5 h-5" />
          </a>
          <a href="mailto:contact@pandoraiptv-nl.com" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:bg-primary hover:text-white transition-colors" aria-label="Email">
            <Mail class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-white font-semibold mb-6">Snelkoppelingen</h3>
        <ul class="space-y-3">
          <li><a href="/" class="text-gray-400 hover:text-primary transition-colors text-sm">Home</a></li>
          <li><a href="/hoe-werkt-het" class="text-gray-400 hover:text-primary transition-colors text-sm">Hoe Werkt Pandora IPTV</a></li>
          <li><a href="/pandora-iptv-review" class="text-gray-400 hover:text-primary transition-colors text-sm">Reviews & Ervaringen</a></li>
          <li><a href="/guides" class="text-gray-400 hover:text-primary transition-colors text-sm">Installatie Handleidingen</a></li>
          <li><a href="/referral" class="text-gray-400 hover:text-primary transition-colors text-sm">Referral Programma</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-primary transition-colors text-sm">Contact & Support</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-white font-semibold mb-6">Juridisch</h3>
        <ul class="space-y-3">
          <li><a href="/privacy" class="text-gray-400 hover:text-primary transition-colors text-sm">Privacybeleid</a></li>
          <li><a href="/terms" class="text-gray-400 hover:text-primary transition-colors text-sm">Algemene Voorwaarden</a></li>
          <li><a href="/refund" class="text-gray-400 hover:text-primary transition-colors text-sm">Restitutiebeleid (24H)</a></li>
          <li><a href="/dmca" class="text-gray-400 hover:text-primary transition-colors text-sm">DMCA Beleid</a></li>
          <li><a href="/disclaimer" class="text-gray-400 hover:text-primary transition-colors text-sm">Disclaimer</a></li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-white font-semibold mb-6">Klantenservice</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3 text-sm text-gray-400">
            <Mail class="w-5 h-5 text-primary shrink-0" />
            <div>
              <a href="mailto:contact@pandoraiptv-nl.com" class="hover:text-white transition-colors block">contact@pandoraiptv-nl.com</a>
              <a href="mailto:support@castvera.com" class="hover:text-white transition-colors block mt-1">support@castvera.com</a>
            </div>
          </li>
          <li class="flex items-start gap-3 text-sm text-gray-400">
            <MessageCircle class="w-5 h-5 text-green-500 shrink-0" />
            <a href="https://wa.me/18036582620" class="hover:text-white transition-colors">WhatsApp: +1 803-658-2620 (24/7)</a>
          </li>
          <li class="flex items-start gap-3 text-sm text-gray-400">
            <ShieldCheck class="w-5 h-5 text-secondary shrink-0" />
            <div>
              <p class="text-white font-semibold">24H Geld-Terug-Garantie</p>
              <p class="text-xs text-gray-400 mt-0.5">Snelle server activatie na betaling</p>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-500 text-sm">
        &copy; {new Date().getFullYear()} Pandora IPTV Nederland (pandoraiptv-nl.com). Alle rechten voorbehouden.
      </p>
      <div class="flex items-center gap-4 text-sm text-gray-500">
        <span>Amsterdam Internet Exchange Backbone</span>
      </div>
    </div>
  </div>
</footer>
