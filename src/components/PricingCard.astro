---
import { Check, Gift, Sparkles, MessageCircle, ShieldCheck } from 'lucide-astro';

interface Props {
  months: string | number;
  price: string | number;
  popular?: boolean;
  hasBonus?: boolean;
}

const {
  months,
  price,
  popular = false,
  hasBonus = false,
} = Astro.props;

const numMonths = Number(months);

// Format titles & durations
const title = numMonths === 12 
  ? "12 Maanden + Bonus" 
  : `${numMonths} ${numMonths === 1 ? 'Maand' : 'Maanden'}`;

const durationText = numMonths === 12 
  ? "per jaar" 
  : numMonths === 1 
    ? "per maand" 
    : `per ${numMonths} maanden`;

const monthlyEquivalent = numMonths > 1 
  ? (Number(price) / numMonths).toFixed(2).replace('.', ',') 
  : null;

// Feature lists without channel numbers or 7-day guarantee
let features: { text: string; highlight?: boolean }[] = [];

if (numMonths === 12) {
  features = [
    { text: "Compleet Aanbod Live TV, Sport & VOD", highlight: true },
    { text: "GRATIS IBO Player App Activatie", highlight: true },
    { text: "Dedicated VIP High-Speed Server" },
    { text: "4K Ultra HD & Full HD Streams" },
    { text: "100% Anti-Buffering & Anti-Freeze" },
    { text: "Interactieve EPG TV-Gids + Terugkijken" },
    { text: "Alle Apparaten (Smart TV, Box, Mobiel)" },
    { text: "VIP 24/7 WhatsApp & Telegram Support" }
  ];
} else if (numMonths === 6) {
  features = [
    { text: "Compleet Aanbod Live TV, Sport & VOD" },
    { text: "4K Ultra HD & Full HD Streams" },
    { text: "Anti-Freeze Server v4.2" },
    { text: "Interactieve EPG + Terugkijken" },
    { text: "Alle Apparaten (Smart TV, Box, Mobiel)" },
    { text: "Prioriteit 24/7 WhatsApp Support" }
  ];
} else if (numMonths === 3) {
  features = [
    { text: "Compleet Aanbod Live TV, Sport & VOD" },
    { text: "4K & Full HD Beeldkwaliteit" },
    { text: "Anti-Freeze Server v4.2" },
    { text: "Interactieve EPG TV-Gids" },
    { text: "Alle Apparaten (Smart TV, Box, Mobiel)" },
    { text: "24/7 WhatsApp Klantenservice" }
  ];
} else {
  // 1 Month
  features = [
    { text: "Compleet Aanbod Live TV, Sport & VOD" },
    { text: "4K & Full HD Beeldkwaliteit" },
    { text: "Anti-Freeze Server v4.2" },
    { text: "Interactieve EPG TV-Gids" },
    { text: "Alle Apparaten (Smart TV, Box, Mobiel)" },
    { text: "24/7 WhatsApp Klantenservice" }
  ];
}

const waMessage = encodeURIComponent(
  `Hallo! Ik wil graag het Pandora IPTV ${title} pakket (€${price}) bestellen.`
);
const orderUrl = `https://wa.me/18036582620?text=${waMessage}`;
---

<div class={`relative rounded-3xl p-6 md:p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-2 backdrop-blur-xl h-full ${
  popular 
    ? 'bg-gradient-to-b from-primary/20 via-background to-background border-2 border-primary shadow-[0_0_40px_rgba(174,28,40,0.25)] ring-1 ring-primary/40' 
    : 'bg-white/5 border border-white/10 hover:border-white/20'
}`}>
  
  {/* Popular Badge */}
  {popular && (
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-gradient-to-r from-primary to-[#d92233] text-white text-xs font-black uppercase tracking-wider py-1 px-4 rounded-full shadow-lg flex items-center gap-1.5 whitespace-nowrap">
      <Sparkles class="w-3.5 h-3.5" />
      Meest Gekozen
    </div>
  )}

  <div>
    {/* Header */}
    <div class="text-center pb-6 border-b border-white/10">
      <h3 class="text-xl font-bold text-white mb-2">{title}</h3>
      
      {hasBonus && (
        <div class="inline-flex items-center gap-1.5 bg-yellow-500/10 text-yellow-400 border border-yellow-500/20 text-xs font-bold px-3 py-1 rounded-full mb-3">
          <Gift class="w-3.5 h-3.5" />
          <span>Inclusief IBO Player Bonus</span>
        </div>
      )}

      <div class="flex items-baseline justify-center gap-1 my-3">
        <span class="text-2xl font-bold text-gray-400">€</span>
        <span class="text-5xl font-black text-white tracking-tight">{price}</span>
        <span class="text-gray-400 text-sm font-medium">/{durationText}</span>
      </div>

      {monthlyEquivalent && (
        <p class="text-xs font-semibold text-primary bg-primary/10 inline-block px-2.5 py-0.5 rounded-md">
          Slechts €{monthlyEquivalent} / maand
        </p>
      )}
    </div>

    {/* Features */}
    <ul class="space-y-3.5 my-6 text-sm">
      {features.map((feature) => (
        <li class="flex items-start gap-3">
          <div class={`mt-0.5 rounded-full p-0.5 shrink-0 ${feature.highlight ? 'bg-primary/20 text-primary' : 'bg-green-500/20 text-green-400'}`}>
            <Check class="w-3.5 h-3.5" />
          </div>
          <span class={`${feature.highlight ? 'text-white font-bold' : 'text-gray-300'}`}>
            {feature.text}
          </span>
        </li>
      ))}
    </ul>
  </div>

  {/* CTA Button & Trust */}
  <div class="pt-4 border-t border-white/10 mt-auto">
    <a 
      href={orderUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={`w-full py-3.5 px-4 font-bold rounded-xl flex items-center justify-center gap-2 transition-all shadow-lg text-sm md:text-base ${
        popular 
          ? 'bg-primary hover:bg-primary/90 text-white shadow-primary/30 hover:scale-[1.02]' 
          : 'bg-white/10 hover:bg-white/20 text-white hover:text-primary'
      }`}
    >
      <MessageCircle class="w-4 h-4" />
      <span>Bestel Nu Direct</span>
    </a>

    <div class="flex items-center justify-center gap-1.5 text-gray-400 text-[11px] mt-3">
      <ShieldCheck class="w-3.5 h-3.5 text-green-400" />
      <span>Directe activatie via WhatsApp</span>
    </div>
  </div>
</div>
