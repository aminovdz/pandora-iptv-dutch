---
import { ArrowRight } from 'lucide-astro';
---

<section class="py-24 relative overflow-hidden">
  <!-- Glassmorphism Container -->
  <div class="container mx-auto px-4 relative z-10">
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-secondary/40 to-primary/20 border border-white/10 backdrop-blur-lg p-10 md:p-16 text-center shadow-2xl">
      <div class="absolute inset-0 bg-[url('/noise.png')] opacity-10 mix-blend-overlay"></div>
      
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 relative z-10">
        Klaar Om De Beste <span class="text-primary">IPTV Pandora</span> Te Ervaren?
      </h2>
      
      <p class="text-lg md:text-xl text-gray-300 mb-10 max-w-2xl mx-auto relative z-10">
        Sluit je aan bij duizenden tevreden klanten en transformeer je tv-ervaring vandaag nog met pandora iptv nederland.
      </p>
      
      <div class="relative z-10 flex flex-col sm:flex-row justify-center items-center gap-4">
        <a href="/#pricing" class="px-8 py-4 text-lg font-bold text-white bg-primary hover:bg-primary/90 rounded-xl transition-all shadow-lg flex items-center gap-2 group">
          Bekijk Onze Pakketten
          <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="https://wa.me/18036582620" class="px-8 py-4 text-lg font-bold text-white bg-white/10 hover:bg-white/20 border border-white/20 rounded-xl transition-all">
          Contacteer Support
        </a>
      </div>
    </div>
  </div>
</section>
