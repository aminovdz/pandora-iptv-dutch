---
import { ChevronDown } from 'lucide-astro';

const faqs = [
  {
    q: "Is Pandora IPTV legaal?",
    a: "Wij bieden toegang tot streaming diensten via geavanceerde technologie. Het gebruik van IPTV is een grijs gebied in sommige regio's, maar wij zorgen voor een veilige, versleutelde verbinding die jouw privacy beschermt."
  },
  {
    q: "Is Pandora IPTV veilig?",
    a: "Ja, veiligheid staat voorop. Wij maken gebruik van SSL-encryptie, veilige betaalmethoden, en garanderen dat er geen malware aanwezig is in onze aanbevolen apps. Je gegevens zijn volledig privé."
  },
  {
    q: "Is Pandora IPTV uit de lucht?",
    a: "Nee, wij hebben een uptime garantie van 99.9%. Met onze robuuste Anti-Buffer technologie en wereldwijde servers zorgen wij voor een uiterst stabiele kijkervaring zonder onderbrekingen."
  },
  {
    q: "Hoe werkt Pandora IPTV?",
    a: "Het is heel eenvoudig: kies een abonnement, installeer een geschikte app zoals IBO Player of Smarters Pro, voer je inloggegevens in die je van ons ontvangt, en je bent direct online."
  },
  {
    q: "Werkt Pandora IPTV in het buitenland?",
    a: "Zeker. Je kunt je Pandora IPTV abonnement overal ter wereld gebruiken, zolang je maar een stabiele internetverbinding hebt."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<section class="py-24 relative z-10 bg-background/50">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Veelgestelde Vragen</h2>
      <p class="text-gray-400 text-lg">Alles wat je moet weten over pandora iptv nederland.</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <div class="border border-white/10 rounded-2xl bg-white/5 overflow-hidden transition-colors">
          <details class="group">
            <summary class="flex justify-between items-center p-6 cursor-pointer list-none font-semibold text-lg text-white">
              <span>{faq.q}</span>
              <span class="transition group-open:rotate-180">
                <ChevronDown class="w-5 h-5 text-gray-400" />
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-400 leading-relaxed">
              <p>{faq.a}</p>
            </div>
          </details>
        </div>
      ))}
    </div>
  </div>

  <!-- Schema Markup injected natively -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</section>

<style>
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }
</style>
