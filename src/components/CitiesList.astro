---
import { MapPin } from 'lucide-astro';
const cities = ['Amsterdam', 'Rotterdam', 'Den Haag', 'Utrecht', 'Eindhoven'];
---

<section class="py-16 relative z-10 bg-background">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Populaire Locaties in Nederland</h2>
      <p class="text-gray-400">Pandora IPTV levert ongeëvenaarde snelheden in deze grote steden.</p>
    </div>
    
    <div class="flex flex-wrap justify-center gap-4">
      {cities.map((city) => (
        <a href={`/locations/${city.toLowerCase().replace(/\s+/g, '-')}`} class="flex items-center gap-2 px-6 py-3 bg-white/5 hover:bg-primary/20 border border-white/10 hover:border-primary/50 rounded-full transition-all group">
          <MapPin class="w-4 h-4 text-gray-400 group-hover:text-primary transition-colors" />
          <span class="text-gray-300 group-hover:text-white font-medium">{city}</span>
        </a>
      ))}
    </div>
  </div>
</section>
