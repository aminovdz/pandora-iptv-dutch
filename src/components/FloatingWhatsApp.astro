---
import { MessageCircle } from 'lucide-astro';
---

<a href="https://wa.me/18036582620" target="_blank" rel="noopener noreferrer" 
   class="fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#20bd5a] text-white p-4 rounded-full shadow-lg shadow-[#25D366]/30 transition-transform hover:scale-110 flex items-center justify-center group"
   aria-label="Contact via WhatsApp">
  <MessageCircle class="w-7 h-7" />
  
  <!-- Tooltip -->
  <div class="absolute right-full mr-4 top-1/2 -translate-y-1/2 bg-white text-gray-900 text-sm font-semibold px-3 py-1.5 rounded shadow-xl opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap">
    Heb je vragen? Chat met ons!
    <!-- Triangle pointer -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 w-2 h-2 bg-white rotate-45"></div>
  </div>
</a>

<!-- Pulsing animation ring -->
<div class="fixed bottom-6 right-6 z-40 w-[60px] h-[60px] bg-[#25D366] rounded-full animate-ping opacity-30 pointer-events-none"></div>
