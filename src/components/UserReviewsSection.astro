---
import { Star, ShieldCheck } from 'lucide-astro';

const reviews = [
  {
    name: "Jan de Vries",
    location: "Amsterdam",
    date: "2 dagen geleden",
    title: "Beste IPTV provider van Nederland",
    text: "Eindelijk een service die niet hapert tijdens belangrijke wedstrijden. Ik gebruik Pandora IPTV nu 3 maanden via mijn Samsung Smart TV met IBO Player en de 4K kwaliteit is verbluffend.",
    rating: 5,
    verified: true
  },
  {
    name: "Sanne K.",
    location: "Rotterdam",
    date: "1 week geleden",
    title: "Super snelle activatie",
    text: "Binnen 5 minuten na aankoop van het 12-maanden pakket had ik alles werkend. De klantenservice via WhatsApp was super behulpzaam bij het instellen van mijn Apple TV.",
    rating: 5,
    verified: true
  },
  {
    name: "Michael B.",
    location: "Eindhoven",
    date: "2 weken geleden",
    title: "Top kwaliteit, geen spijt",
    text: "Ik was sceptisch door eerdere slechte ervaringen, maar iptv pandora maakt alle beloftes waar. Alle zenders zijn netjes gecategoriseerd en VOD sectie is enorm.",
    rating: 5,
    verified: true
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Pandora IPTV Abonnement",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1048"
  },
  "review": reviews.map(r => ({
    "@type": "Review",
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": r.rating.toString()
    },
    "author": {
      "@type": "Person",
      "name": r.name
    },
    "reviewBody": r.text
  }))
};
---

<section class="py-24 relative z-10 bg-background border-t border-white/5">
  <div class="container mx-auto px-4">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="flex justify-center items-center gap-2 mb-4">
        <div class="flex">
          {[1,2,3,4,5].map(() => <Star class="w-6 h-6 text-green-500 fill-green-500" />)}
        </div>
        <span class="text-xl font-bold text-white">4.9/5</span>
      </div>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6">Wat Onze <span class="text-primary">Klanten Zeggen</span></h2>
      <p class="text-gray-400 text-lg">Meer dan 10.000 tevreden gebruikers in heel Nederland gingen je al voor.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {reviews.map((review) => (
        <div class="bg-white/5 border border-white/10 p-8 rounded-2xl backdrop-blur-sm hover:-translate-y-2 transition-transform duration-300">
          <div class="flex items-center justify-between mb-4">
            <div class="flex text-green-500">
              {[...Array(review.rating)].map(() => <Star class="w-4 h-4 fill-current" />)}
            </div>
            <span class="text-xs text-gray-500">{review.date}</span>
          </div>
          <h3 class="font-bold text-white mb-3 text-lg">"{review.title}"</h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-6">"{review.text}"</p>
          <div class="flex items-center justify-between border-t border-white/10 pt-4 mt-auto">
            <div>
              <p class="text-white font-medium text-sm">{review.name}</p>
              <p class="text-gray-500 text-xs">{review.location}</p>
            </div>
            {review.verified && (
              <div class="flex items-center gap-1 text-xs text-green-500 font-medium bg-green-500/10 px-2 py-1 rounded">
                <ShieldCheck class="w-3 h-3" /> Geverifieerd
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-12 text-center">
      <a href="/pandora-iptv-review" class="inline-flex items-center gap-2 text-primary hover:text-white font-semibold transition-colors">
        Bekijk alle onafhankelijke reviews &rarr;
      </a>
    </div>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaData)} />
</section>
